# Lane's domain routes account API traffic and serves avatars/share links.
VITE_API_URL=https://lane-app.site
# Public HTTPS URL of the Lane API service deployed alongside your PostgreSQL database.
VITE_NEW_ACCOUNT_API_URL=https://lane-account-api.nidenseekn.workers.dev
VITE_COVERS_PROXY_URL=https://covers.tryliner.fun
# Optional: authorized public HTTPS lyrics catalog (origin only). It must
# allow cross-origin GET /v1/tracks/:id/lyrics and return Lane-compatible lyrics.
# Lane does not send account tokens, cookies or request signatures to this origin.
VITE_PUBLIC_LYRICS_CATALOG_URL=

LINER_DEV_SIGNING_SECRET=
