{
  "name": "lane",
  "version": "1.5.1",
  "type": "module",
  "private": true,
  "description": "Lane Music Player",
  "author": {
    "name": "hkamori",
    "email": "dev@tryliner.fun"
  },
  "desktopName": "lane",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:potoken": "vite build --config vite.potoken.config.ts",
    "build": "tsc -b && vite build",
    "bundle:publish": "pnpm --dir ../updater bundle:publish",
    "signer:build": "node ../signer/scripts/build-wasm.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:build": "tsc -b && vite build && electron-builder",
    "electron:build:linux": "tsc -b && vite build && electron-builder --linux",
    "electron:build:win": "pnpm native:build && tsc -b && vite build && electron-builder --win",
    "electron:build:mac": "tsc -b && vite build && electron-builder --mac",
    "native:build": "pnpm dlx node-gyp@11 rebuild --directory native/snap-preview && node scripts/verify-native-addon.cjs"
  },
  "build": {
    "appId": "com.therikky.lane",
    "productName": "Lane",
    "executableName": "lane",
    "artifactName": "Lane-${version}-${arch}.${ext}",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Liner",
        "schemes": [
          "liner"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "native/snap-preview/build/Release/snap_preview.node"
    ],
    "linux": {
      "executableName": "lane",
      "syncDesktopName": true,
      "maintainer": "hkamori <dev@tryliner.fun>",
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "synopsis": "Lane — music player"
    },
    "deb": {
      "packageName": "lane",
      "artifactName": "lane_${version}_amd64.deb",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "appImage": {
      "artifactName": "Lane-${version}-${arch}.AppImage"
    },
    "win": {
      "executableName": "Lane",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Lane-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Lane",
      "uninstallDisplayName": "Lane"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "asarUnpack": [
      "native/**/*.node"
    ],
    "rpm": {
      "packageName": "lane",
      "artifactName": "lane-${version}.x86_64.rpm",
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none",
        "--replaces=liner",
        "--conflicts=liner"
      ]
    },
    "portable": {
      "artifactName": "Lane-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@braccato/core": "^1.4.0",
    "@braccato/parsers": "^0.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@mingcute/react": "^1.4.1",
    "@solar-icons/react": "^1.1.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@xhayper/discord-rpc": "^1.5.1",
    "bgutils-js": "4.0.3",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "morphicons": "^1.7.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-apple-emojis": "^3.0.0",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.2",
    "solar-icons": "^0.0.15",
    "soundtouchjs": "^0.3.0",
    "tar": "^7.5.22",
    "youtubei.js": "18.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar": "^7.0.87",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.9"
  }
}
